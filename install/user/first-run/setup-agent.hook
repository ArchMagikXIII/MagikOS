#!/bin/bash

set -e

# Magikos ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(magikos-default-agent) ]] && magikos-done ensure agent-setup-invitation; then
  magikos-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Magikos." \
    --exec "magikos menu summon setup.default.agent"
fi
