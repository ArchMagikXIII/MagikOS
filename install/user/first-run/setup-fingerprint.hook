#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if magikos-hw-fingerprint && [[ ! -f /etc/pam.d/magikos-lock-fingerprint ]] &&
  magikos-done ensure fingerprint-setup-invitation; then
  magikos-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec "magikos-launch-floating-terminal-with-presentation magikos-setup-security-fingerprint"
fi
