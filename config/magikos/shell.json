{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "magikos.clock",
    "layout": {
      "left": [
        {
          "id": "magikos.workspaces"
        }
      ],
      "center": [
        {
          "id": "magikos.indicators"
        },
        {
          "id": "magikos.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "magikos.keyboard-layout"
        },
        {
          "id": "magikos.weather"
        },
        {
          "id": "magikos.system-update"
        }
      ],
      "right": [
        {
          "id": "magikos.tray"
        },
        {
          "id": "magikos.agents"
        },
        {
          "id": "magikos.bluetooth"
        },
        {
          "id": "magikos.network"
        },
        {
          "id": "magikos.audio"
        },
        {
          "id": "magikos.monitor"
        },
        {
          "id": "magikos.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": []
}
