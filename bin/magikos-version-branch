#!/bin/bash
# magikos-version-branch — show current git branch
magikos_path="${MAGIKOS_PATH:-/usr/share/magikos}"
magikos_path="${magikos_path%/}"
[[ "$magikos_path" != "/usr/share/magikos" ]] || exit 1
branch=$(git -C "$magikos_path" branch --show-current 2>/dev/null || true)
[[ -n "$branch" ]] || { hash=$(git -C "$magikos_path" rev-parse --short HEAD 2>/dev/null || true); [[ -n "$hash" ]] || exit 1; branch="detached@$hash"; }
echo "$branch"
