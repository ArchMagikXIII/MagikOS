#!/bin/bash

# magikos:summary=Launch an app or focus an existing window matching a pattern
# magikos:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: magikos-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
WINDOW_ID=$(swaymsg -t get_tree 2>/dev/null | jq -r --arg p "$WINDOW_PATTERN" '
  .. | objects
  | select(
      (.app_id? // "" | test("\\b" + $p + "\\b";"i")) or
      (.window_properties.class? // "" | test("\\b" + $p + "\\b";"i")) or
      (.name? // "" | test("\\b" + $p + "\\b";"i"))
    )
  | .id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  swaymsg "[con_id=$WINDOW_ID] focus" >/dev/null 2>&1
else
  eval exec setsid $LAUNCH_COMMAND
fi
