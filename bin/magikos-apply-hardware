#!/bin/bash

# magikos:summary=Apply Magikos hardware-specific packages and system configuration
# magikos:group=apply
# magikos:requires-sudo=true
# magikos:examples=magikos apply hardware --install-user dhh
# magikos:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: magikos apply hardware --install-user USER
       magikos apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by magikos-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/magikos/provisioning/groups.
USAGE
}

install_user="${MAGIKOS_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: magikos-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export MAGIKOS_INSTALL_USER="$install_user"
export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"
export MAGIKOS_INSTALL="${MAGIKOS_INSTALL:-$MAGIKOS_PATH/install}"
export MAGIKOS_INSTALL_LOG_FILE="${MAGIKOS_INSTALL_LOG_FILE:-/var/log/magikos-install.log}"
export PATH="$MAGIKOS_PATH/bin:$PATH"

source "$MAGIKOS_INSTALL/helpers/logging.sh"

# Same rationale as magikos-apply-system: hardware leaves call sudo, which a
# minimal target may not have, and we are root already.
if (( EUID == 0 )) && magikos-cmd-missing sudo; then
  sudo() { "$@"; }
  export -f sudo
fi

# Every leaf here is independently gated on a magikos-hw-* probe and installs
# one vendor package, so a failure means "this machine does not need it", not
# "stop". Without this the first unresolvable package name aborted the chain
# and every tweak after it was skipped without a word.
export MAGIKOS_INSTALL_BEST_EFFORT=1
MAGIKOS_INSTALL_SKIPPED_LEAVES=()

source "$MAGIKOS_INSTALL/hardware/all.sh"

if ((${#MAGIKOS_INSTALL_SKIPPED_LEAVES[@]} > 0)); then
  printf '\033[33m==> %s hardware step(s) did not apply on this machine:\033[0m\n' \
    "${#MAGIKOS_INSTALL_SKIPPED_LEAVES[@]}" >&2
  for step in "${MAGIKOS_INSTALL_SKIPPED_LEAVES[@]}"; do
    printf '    %s\n' "${step##*/}" >&2
  done
  printf '    Detail: %s\n' "${MAGIKOS_INSTALL_LOG_FILE:-the install log}" >&2
fi
