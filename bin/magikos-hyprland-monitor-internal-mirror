#!/bin/bash

# magikos:summary=Enable, disable, toggle, or recover mirroring the internal display to an external monitor
# magikos:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/magikos/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(magikos-hyprland-monitor-laptop)
# The first active external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    magikos-notification-send -g 󰍹 "No external monitors found for mirror"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    magikos-notification-send -g 󰍹 "No laptop monitor found to mirror"
    exit 1
  fi

  magikos-hyprland-toggle $DISABLE_TOGGLE off

  if magikos-hyprland-toggle-disabled $TOGGLE; then
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG"
    magikos-notification-send -g 󰍹 "Mirroring enabled ($EXTERNAL)"
    hyprctl reload
  fi
}

off() {
  if magikos-hyprland-toggle-enabled $TOGGLE; then
    magikos-hyprland-toggle $TOGGLE off
    magikos-notification-send -g 󰍹 "Extended mode restored"
  fi
}

toggle() {
  if magikos-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! magikos-hyprland-monitor-external-active && magikos-hyprland-toggle-enabled $TOGGLE; then
    magikos-hyprland-toggle $TOGGLE off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
