#!/bin/bash

# magikos:summary=Show which theme is styling the Plymouth boot screen
# magikos:examples=magikos plymouth current

# magikos-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/magikos/logo.png

if cmp -s "$MAGIKOS_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

magikos-plymouth-list | while read -r name; do
  if cmp -s "$(magikos-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
