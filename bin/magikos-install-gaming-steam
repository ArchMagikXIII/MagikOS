#!/bin/bash

# magikos:summary=Install Steam and graphics drivers selected for this system
# magikos:requires-sudo=true

set -e

echo "Installing Steam..."
magikos-pkg-add steam
magikos-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
