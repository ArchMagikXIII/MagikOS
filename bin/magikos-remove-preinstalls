#!/bin/bash

# magikos:summary=Remove preinstalled Magikos applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Magikos applications...\n"

  magikos-webapp-remove-all
  magikos-tui-remove-all

  mkdir -p ~/.local/state/magikos
  touch ~/.local/state/magikos/preinstalls-removed

  # Remove mise stubs
  rm -f ~/.local/bin/codex ~/.local/bin/claude ~/.local/bin/agy ~/.local/bin/copilot \
       ~/.local/bin/gh ~/.local/bin/opencode ~/.local/bin/playwright ~/.local/bin/playwright-cli ~/.local/bin/pi \
       ~/.local/bin/omp ~/.local/bin/grok ~/.local/bin/crush ~/.local/bin/ghui ~/.local/bin/hunk

  magikos-pkg-drop \
    cliamp
fi
