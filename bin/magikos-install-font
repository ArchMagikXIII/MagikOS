#!/bin/bash

# magikos:summary=Install a Nerd Font package and switch the system to it
# magikos:args=<display-name> <package> <family>
# magikos:examples=magikos install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: magikos-install-font <display-name> <package> <family>" >&2
  exit 1
fi

exec magikos-launch-floating-terminal-with-presentation \
  "echo 'Installing ${name}...'; magikos-pkg-add ${package} && sleep 2 && magikos-font-set '${family}'"
