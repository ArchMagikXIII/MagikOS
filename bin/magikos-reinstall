#!/bin/bash

# magikos:summary=Reinstall Magikos packages and reset default configs
# magikos:requires-sudo=true

set -e

echo -e "This will reinstall all default Magikos packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  magikos-reinstall-pkgs
  magikos-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && magikos-system-reboot
fi
