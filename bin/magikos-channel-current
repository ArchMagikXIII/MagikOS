#!/bin/bash

# magikos:summary=Print the active Magikos package channel

set -euo pipefail

# Dev is a linked source checkout: MAGIKOS_PATH points somewhere other than
# the package-backed install at /usr/share/magikos. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $MAGIKOS_PATH != "/usr/share/magikos" ]]; then
  echo dev
  exit 0
fi

# magikos-dev / magikos-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. magikos / magikos-settings come
# from either the stable or rc mirror, distinguished by magikos-version-channel
# (which reports the mirror as its first token).
if pacman -Q magikos-dev magikos-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q magikos magikos-settings >/dev/null 2>&1; then
  channel=$(magikos-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
