#!/bin/bash

# magikos:summary=Launch the Magikos screensaver in the default terminal on the system with the correct font configuration.

# Exit early if screensaver is already running
pgrep -f '[o]rg.magikos.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if magikos-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(swaymsg -t get_outputs -r 2>/dev/null | jq -r '.[] | select(.focused == true) | .name')
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  magikos-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

# Open the compositor's event stream before spawning anything, so a terminal that maps
# quickly can't emit its window-open event before we are listening for it.
exec {events}< <(swaymsg -m -t subscribe '["window"]')

# Spawning is async and a new window maps on whatever output is focused at that
# moment. Block until this output's screensaver actually opens before moving
# focus on -- otherwise slow-starting terminals all pile onto the last output.
# The deadline is a safety net in case the window never appears.
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == *'"change":"new"'*org.magikos.screensaver* ]] && return 0
  done
}

for m in $(swaymsg -t get_outputs -r 2>/dev/null | jq -r '.[] | select(.active == true) | .name'); do
  swaymsg focus output "$m" >/dev/null 2>&1

  case $terminal in
  *Alacritty*)
    setsid alacritty --class=org.magikos.screensaver --config-file "$MAGIKOS_PATH/default/alacritty/screensaver.toml" -e magikos-screensaver >/dev/null 2>&1 &
    ;;
  *ghostty*)
    setsid ghostty --class=org.magikos.screensaver --config-file="$MAGIKOS_PATH/default/ghostty/screensaver" --font-size=18 -e magikos-screensaver >/dev/null 2>&1 &
    ;;
  *foot*)
    setsid foot --app-id=org.magikos.screensaver --config="$MAGIKOS_PATH/default/foot/screensaver.ini" -e magikos-screensaver >/dev/null 2>&1 &
    ;;
  *kitty*)
    setsid kitty --class=org.magikos.screensaver --override font_size=18 --override window_padding_width=0 -e magikos-screensaver >/dev/null 2>&1 &
    ;;
  esac

  wait_for_screensaver_window
done

swaymsg focus output "$focused" >/dev/null 2>&1
