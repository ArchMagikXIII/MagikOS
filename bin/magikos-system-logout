#!/bin/bash

# magikos:summary=Log out after closing application windows
# magikos:examples=magikos logout | magikos system logout
# magikos:aliases=magikos logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

magikos-osd -i logout -m "Logging out" -d 5000

# Now close all windows
magikos-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
