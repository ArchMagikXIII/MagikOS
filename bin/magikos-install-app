#!/bin/bash

# magikos:summary=Install a packaged app, surfacing the install in a floating terminal
# magikos:args=<display-name> <packages>
# magikos:examples=magikos install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: magikos-install-app <display-name> <packages>" >&2
  exit 1
fi

exec magikos-launch-floating-terminal-with-presentation "echo 'Installing ${name}...'; magikos-pkg-add ${packages}"
