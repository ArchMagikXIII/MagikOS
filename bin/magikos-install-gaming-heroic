#!/bin/bash

# magikos:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# magikos:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
magikos-pkg-add heroic-games-launcher-bin
magikos-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
