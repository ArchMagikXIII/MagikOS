#!/bin/bash

# magikos:summary=Open the Plymouth unlock screen switcher

preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/magikos/unlock-selector/previews"

rm -rf "$preview_dir"
mkdir -p "$preview_dir"

ln -s "$MAGIKOS_PATH/default/plymouth/preview-unlock.png" "$preview_dir/default.png"

magikos-plymouth-list | while read -r name; do
  ln -s "$(magikos-theme-dir "$name")/preview-unlock.png" "$preview_dir/$name.png" 2>/dev/null
done

current=$(magikos-plymouth-current)
selected=""
[[ -n $current && -e $preview_dir/$current.png ]] && selected="$preview_dir/$current.png"

exec magikos-menu-images --print-name --show-labels --selected "$selected" "$preview_dir"
