#!/bin/bash

# magikos:summary=Select and set the system timezone
# magikos:group=menu
# magikos:name=timezone

set -e

timezone=$(timedatectl list-timezones | magikos-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
magikos-shell -q magikos.clock refresh
magikos-notification-send "Timezone is now set to $timezone"
