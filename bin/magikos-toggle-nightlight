#!/bin/bash

# magikos:summary=Toggle nightlight screen temperature
# magikos:args=[--status]
# magikos:examples=magikos toggle nightlight

ON_TEMP=4000
OFF_TEMP=6500
IDENTITY_TEMP=6000

# wlsunset cannot be queried live; the running daemon's own arguments are the
# source of truth. Equal -t/-T values pin a constant temperature immediately,
# so the daemon is always started with both flags set to the same value.
current_temp() {
  local line
  line=$(pgrep -ax wlsunset 2>/dev/null | head -n1) || return
  awk '{for(i=2;i<NF;i++) if($i=="-t"){print $(i+1); exit}}' <<<"$line"
}

start_nightlight() {
  setsid uwsm-app -- wlsunset -t "$1" -T "$1" >/dev/null 2>&1 &
}

stop_nightlight() {
  pkill -x wlsunset 2>/dev/null
}

status_json() {
  local temp enabled

  temp=$(current_temp)
  if [[ -n $temp ]] && (( temp < IDENTITY_TEMP )); then
    enabled=true
  else
    enabled=false
  fi

  jq -cn --argjson enabled "$enabled" --arg temp "$temp" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

# Query the current temperature
CURRENT_TEMP=$(current_temp)

if [[ -z $CURRENT_TEMP || $CURRENT_TEMP == $OFF_TEMP ]]; then
  TARGET_TEMP=$ON_TEMP
else
  TARGET_TEMP=$OFF_TEMP
fi

# Killing the daemon restores native daylight; restarting it applies the
# target temperature right away thanks to the equal low/high pair.
stop_nightlight
if (( TARGET_TEMP != OFF_TEMP )); then
  start_nightlight "$TARGET_TEMP"
fi

magikos-shell -q nightlight refresh
