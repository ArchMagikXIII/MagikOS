#!/bin/bash

# magikos:summary=List available themes
# magikos:examples=magikos theme list | magikos theme set "Tokyo Night"

{
  find ~/.config/magikos/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$MAGIKOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
