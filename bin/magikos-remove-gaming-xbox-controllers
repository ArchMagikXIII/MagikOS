#!/bin/bash

# magikos:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# magikos:group=remove
# magikos:name=gaming xbox-controllers
# magikos:requires-sudo=true

set -e

magikos-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
