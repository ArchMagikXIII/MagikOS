#!/bin/bash

# magikos:summary=Install packages if they are missing
# magikos:args=<packages...>
# magikos:examples=magikos pkg add jq ripgrep
# magikos:requires-sudo=true

source magikos-pkg-backend

# Resolve through the backend first: a caller may name the package the way the
# upstream project does (sof-firmware) while the active manager knows it by
# another name (firmware-sof-signed). pkg_installed resolves too, so the
# post-install check below still verifies what was asked for.
resolved=()
for pkg in "$@"; do
  resolved+=("$(pkg_resolve_name "$pkg")")
done

if magikos-pkg-missing "${resolved[@]}"; then
  if (( EUID == 0 )); then
    "${PKG_INSTALL_CMD[@]}" "${resolved[@]}" || exit 1
  else
    sudo "${PKG_INSTALL_CMD[@]}" "${resolved[@]}" || exit 1
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where the backend doesn't actually register an error
  if ! pkg_installed "$pkg"; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
