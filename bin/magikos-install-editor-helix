#!/bin/bash

# magikos:summary=Install Helix and configure it to use the current Magikos theme

echo "Installing Helix..."
magikos-pkg-add helix

mkdir -p ~/.config/helix/themes

# Symlink the rendered Magikos theme so Helix tracks the active theme
ln -sf "$HOME/.local/state/magikos/current/theme/helix.toml" ~/.config/helix/themes/magikos.toml

# Only seed a config.toml if the user does not already have one
if [[ ! -f ~/.config/helix/config.toml ]]; then
  cat >~/.config/helix/config.toml <<'EOF'
theme = "magikos"
EOF
fi

# Ensure the symlink target exists for users whose current theme predates this template
if [[ ! -e $HOME/.local/state/magikos/current/theme/helix.toml ]]; then
  magikos-theme-refresh
fi

# Arch-based distros ship Helix as 'helix' rather than the upstream 'hx'.
if ! grep -q '^alias hx="helix"' ~/.bashrc 2>/dev/null; then
  echo 'alias hx="helix"' >>~/.bashrc
fi
