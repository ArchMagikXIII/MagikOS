#!/bin/bash

# magikos:summary=Show a fuzzy-finder TUI for picking packages installed on the system to be removed.
# magikos:requires-sudo=true

source magikos-pkg-backend

case $MAGIKOS_PKG_BACKEND in
  pacman) preview_cmd='pacman -Qi {1}' ;;
  dnf) preview_cmd='dnf info {1}' ;;
esac

fzf_args=(
  --multi
  --preview "$preview_cmd"
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:red,marker:red'
)

pkg_names=$(pkg_list_explicit | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  # Convert newline-separated selections to space-separated for the backend
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo "${PKG_REMOVE_CMD[@]}"
  magikos-show-done
fi
