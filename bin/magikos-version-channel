#!/bin/bash

# magikos:summary=Print the active Magikos mirror and package channel

if grep -q "https://stable-mirror.magikos.org/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -q "https://rc-mirror.magikos.org/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -q "https://mirror.magikos.org/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.magikos.org/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.magikos.org/edge/" /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
