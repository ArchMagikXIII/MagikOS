#!/bin/bash

# magikos:summary=Install a supported browser
# magikos:args=<chromium|chrome|brave|brave-origin|edge|firefox|zen>
# magikos:examples=magikos install browser chromium | magikos install browser firefox

set -e

setup_policy_directory() {
  sudo mkdir -p "$1"
  sudo chmod a+rw "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$MAGIKOS_PATH/config/chromium-flags.conf" "$1"
  magikos-install-chromium-copy-url
  magikos-install-chromium-ytdlp
}

setup_firefox_preferences() {
  local distribution_dir="$1"

  setup_policy_directory "$distribution_dir"
  sudo cp -f "$MAGIKOS_PATH/default/firefox/policies.json" "$distribution_dir/policies.json"
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/magikos-firefox-wayland.conf
}

case $1 in
chromium)
  echo "Installing Chromium..."
  magikos-pkg-add chromium

  setup_policy_directory /etc/chromium/policies/managed
  copy_chromium_flags ~/.config/chromium-flags.conf
  magikos-theme-set-browser
  announce_browser_installed "Chromium"
  ;;
chrome)
  echo "Installing Chrome..."
  magikos-pkg-aur-add google-chrome || exit 1

  setup_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  magikos-theme-set-browser
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  magikos-pkg-aur-add microsoft-edge-stable-bin || exit 1

  setup_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  magikos-theme-set-browser
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  magikos-pkg-aur-add brave-bin || exit 1

  setup_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  magikos-theme-set-browser
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  magikos-pkg-aur-add brave-origin-bin || exit 1

  setup_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-origin-flags.conf
  magikos-theme-set-browser
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  magikos-pkg-add firefox || exit 1

  setup_firefox_preferences /usr/lib/firefox/distribution
  setup_firefox_wayland
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  magikos-pkg-aur-add zen-browser-bin || exit 1

  setup_firefox_preferences /opt/zen-browser/distribution
  setup_firefox_wayland
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: magikos-install-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
