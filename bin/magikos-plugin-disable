#!/bin/bash

# magikos:summary=Disable a shell plugin
# magikos:group=plugin
# magikos:args=<id>

set -euo pipefail

fail() {
  echo "magikos-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: magikos plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(magikos-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: magikos-shell shell rescanPlugins"

echo "Disabled $id"
