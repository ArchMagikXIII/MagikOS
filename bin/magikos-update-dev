#!/bin/bash

# magikos:summary=Update the active Magikos dev checkout

set -euo pipefail

[[ $MAGIKOS_PATH != "/usr/share/magikos" ]] || exit 0

if ! git -C "$MAGIKOS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: MAGIKOS_PATH is not a git checkout: $MAGIKOS_PATH" >&2
  exit 1
fi

upstream=$(git -C "$MAGIKOS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Magikos dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Magikos dev checkout\e[0m"
git -C "$MAGIKOS_PATH" pull --ff-only
