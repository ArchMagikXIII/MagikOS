#!/bin/bash

# magikos:summary=Launch a floating terminal with the Magikos presentation wrapper
# magikos:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source magikos-restart-gum

cmd="$*"
presentation_script="magikos-show-logo; $cmd; if (( \$? != 130 )); then magikos-show-done; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.magikos.terminal --title=Magikos -- bash -c "$presentation_script"
