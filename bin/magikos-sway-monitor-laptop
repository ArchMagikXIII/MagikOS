#!/bin/bash

# magikos:summary=Print the name of the built-in laptop display, including disabled outputs.

if swaymsg -t get_version >/dev/null 2>&1; then
  swaymsg -t get_outputs -r 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")).name' | head -n 1
elif magikos-cmd-present hyprctl; then
  hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")).name' | head -n 1
fi
