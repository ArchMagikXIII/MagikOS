#!/bin/bash

# magikos:summary=Update MagikOS and system packages with topgrade
# magikos:requires-sudo=true

set -e

if [[ -z ${MAGIKOS_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env MAGIKOS_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/magikos-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://magikos.org/discord\033[0m"' ERR

echo -e "\033[1;32m=== MagikOS Update (topgrade) ===\033[0m\n"

# topgrade drives the whole update. MAGIKOS_UPDATE_PACMAN lets topgrade's
# internal pacman step past the magikos-update-pacman-guard hook, which would
# otherwise block it as a "direct" system upgrade.
MAGIKOS_UPDATE_PACMAN=1 topgrade "$@"

# Migrations ship with the packages the upgrade installs and are written against
# them, so they only run once the package upgrade actually went through.
# Post-update hooks have no login-time runner, so they follow the update here.
magikos-migrate || true
magikos-hook post-update || true
