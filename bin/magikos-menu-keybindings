#!/bin/bash

# magikos:summary=Display Sway keybindings defined in your configuration using an interactive search menu.

# Some bindings use raw XKB keycodes. Resolve them to symbols
# via the compiled keymap, with a small fallback for common keys so the menu
# remains readable if xkbcli cannot resolve a symbol.
parse_keycodes() {
  awk '
    BEGIN {
      split("10=1 11=2 12=3 13=4 14=5 15=6 16=7 17=8 18=9 19=0 20=MINUS 21=EQUAL 59=COMMA 60=PERIOD 61=SLASH", fallbacks, " ")
      for (i in fallbacks) {
        separator = index(fallbacks[i], "=")
        keycode_symbol[substr(fallbacks[i], 1, separator - 1)] = substr(fallbacks[i], separator + 1)
      }

      # </dev/null keeps xkbcli from consuming the binding records on stdin
      keymap_cmd = "xkbcli compile-keymap </dev/null"
      section = ""
      while ((keymap_cmd | getline line) > 0) {
        if (line ~ /xkb_keycodes/) { section = "codes"; continue }
        if (line ~ /xkb_symbols/)  { section = "syms";  continue }
        if (section == "codes" && match(line, /<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;/, m)) code_by_name[m[1]] = m[2]
        if (section == "syms" && match(line, /key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^, \]]+)/, m)) sym_by_name[m[1]] = m[2]
      }
      close(keymap_cmd)

      for (name in code_by_name) {
        code = code_by_name[name]
        symbol = sym_by_name[name]
        if (code != "" && symbol != "" && symbol != "NoSymbol") keycode_symbol[code] = toupper(symbol)
      }

      mouse_symbol["272"] = "LEFT MOUSE BUTTON"
      mouse_symbol["273"] = "RIGHT MOUSE BUTTON"
      mouse_symbol["274"] = "MIDDLE MOUSE BUTTON"
    }
    {
      if (match($0, /code:([0-9]+)/, match_parts)) {
        code = match_parts[1]
        symbol = keycode_symbol[code]
        if (symbol == "") symbol = "code:" code
        sub("code:" code, symbol)
      } else if (match($0, /mouse:([0-9]+)/, match_parts)) {
        code = match_parts[1]
        symbol = mouse_symbol[code]
        if (symbol == "") symbol = "mouse:" code
        sub("mouse:" code, symbol)
      }

      print
    }
  '
}


# Sway support: sway exposes no IPC for listing bindings, so parse
# bindsym/bindcode entries straight from the user's config (bindings.conf plus
# the main config). The config carries no descriptions either, so known
# commands are mapped to human-readable labels and dispatched verbatim.
declare -A SWAY_VARIABLES
SWAY_BIND_FILES=()

compositor_is_sway() {
  [[ -n $SWAYSOCK ]]
}

discover_sway_bind_files() {
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sway"

  SWAY_BIND_FILES=()
  [[ -f $config_dir/bindings.conf ]] && SWAY_BIND_FILES+=("$config_dir/bindings.conf")
  [[ -f $config_dir/config ]] && SWAY_BIND_FILES+=("$config_dir/config")

  ((${#SWAY_BIND_FILES[@]} > 0))
}

load_sway_variables() {
  local file line name value

  SWAY_VARIABLES=(["mod"]="Mod4")

  for file in "${SWAY_BIND_FILES[@]}"; do
    while IFS= read -r line; do
      [[ $line =~ ^[[:space:]]*set[[:space:]]+\$([A-Za-z0-9_]+)[[:space:]]+(.+)$ ]] || continue
      name="${BASH_REMATCH[1]}"
      value=$(trim "${BASH_REMATCH[2]}")
      [[ -n $value ]] && SWAY_VARIABLES[$name]="$value"
    done <"$file"
  done
}

sway_resolve_combo() {
  local combo="$1"
  local part resolved key="" mods_text=" "
  local candidate member
  local -a parts=() mods=()
  local -a order=(SHIFT CTRL ALT SUPER LOCK NUMLOCK MOD3 MOD5)

  IFS='+' read -ra parts <<<"$combo"
  for part in "${parts[@]}"; do
    part=$(trim "$part")
    [[ -z $part ]] && continue

    if [[ $part == \$* ]]; then
      resolved="${SWAY_VARIABLES[${part#\$}]:-$part}"
    else
      resolved="$part"
    fi

    case "$resolved" in
      Shift|shift) mods+=("SHIFT") ;;
      Control|Control_L|Ctrl|ctrl) mods+=("CTRL") ;;
      Mod1|Alt|alt) mods+=("ALT") ;;
      Mod4|Super|super) mods+=("SUPER") ;;
      Lock) mods+=("LOCK") ;;
      Mod2) mods+=("NUMLOCK") ;;
      Mod3) mods+=("MOD3") ;;
      Mod5) mods+=("MOD5") ;;
      *) key="$resolved" ;;
    esac
  done

  for candidate in "${order[@]}"; do
    for member in "${mods[@]}"; do
      if [[ $member == "$candidate" && $mods_text != *" $candidate "* ]]; then
        mods_text+="$candidate "
      fi
    done
  done

  mods_text="${mods_text# }"
  printf '%s\x1f%s' "${mods_text% }" "$key"
}

# Strip exec/env wrappers so descriptions can be matched on the bare command.
sway_normalize_command() {
  local cmd="$1" variable

  while true; do
    if [[ $cmd == "exec "* ]]; then
      cmd="${cmd#exec }"
    elif [[ $cmd == "env "* ]]; then
      variable="${cmd#env }"
      variable="${variable%% *}"
      if [[ $variable == *=* ]]; then
        cmd="${cmd#"env $variable"}"
        cmd=$(trim "$cmd")
      else
        break
      fi
    else
      break
    fi
  done

  printf '%s\n' "$cmd"
}

sway_binding_description() {
  local cmd tail
  cmd=$(sway_normalize_command "$1")

  case "$cmd" in
    kill) echo "Close window" ;;
    "floating toggle") echo "Toggle window floating" ;;
    "layout toggle split") echo "Toggle window split" ;;
    "fullscreen toggle global") echo "Full width across monitors" ;;
    "fullscreen toggle") echo "Full screen" ;;
    "sticky toggle") echo "Toggle sticky window" ;;
    "scratchpad show") echo "Show scratchpad" ;;
    "move scratchpad") echo "Move window to scratchpad" ;;
    "focus left") echo "Focus left" ;;
    "focus right") echo "Focus right" ;;
    "focus up") echo "Focus up" ;;
    "focus down") echo "Focus down" ;;
    "move left") echo "Move window left" ;;
    "move right") echo "Move window right" ;;
    "move up") echo "Move window up" ;;
    "move down") echo "Move window down" ;;
    "resize grow width"*) echo "Resize window wider" ;;
    "resize shrink width"*) echo "Resize window narrower" ;;
    "resize grow height"*) echo "Resize window taller" ;;
    "resize shrink height"*) echo "Resize window shorter" ;;
    "workspace number "*) echo "Switch to workspace ${cmd#"workspace number "}" ;;
    "workspace back_and_forth") echo "Switch to previous workspace" ;;
    "workspace prev_on_output") echo "Previous workspace on output" ;;
    "workspace prev") echo "Previous workspace" ;;
    "workspace next_on_output") echo "Next workspace on output" ;;
    "workspace next") echo "Next workspace" ;;
    "move container to workspace number "*)
      tail="${cmd#"move container to workspace number "}"
      tail=$(trim "${tail%%;*}")
      if [[ $cmd == *";"* ]]; then
        echo "Move window to workspace $tail"
      else
        echo "Move window silently to workspace $tail"
      fi
      ;;
    reload) echo "Reload sway configuration" ;;
    exit) echo "Exit sway" ;;
    "magikos-menu toggle apps") echo "Apps menu" ;;
    "magikos-menu toggle system") echo "System menu" ;;
    "magikos-menu toggle style.theme"*) echo "Theme menu" ;;
    "magikos-menu toggle"*) echo "Magikos menu" ;;
    "magikos-shell shell toggle magikos.clipboard"*) echo "Clipboard history" ;;
    swaylock*) echo "Lock system" ;;
    foot) echo "Terminal" ;;
    brave-origin*) echo "Browser" ;;
    'swaymsg [workspace="__current__"] kill') echo "Close all windows in current workspace" ;;
    wpctl\ set-mute\ @DEFAULT_AUDIO_SINK@\ *) echo "Toggle audio mute" ;;
    wpctl\ set-mute\ @DEFAULT_AUDIO_SOURCE@\ *) echo "Toggle microphone mute" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SINK@\ 1%+*) echo "Raise volume slightly" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SINK@\ 1%-*) echo "Lower volume slightly" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SINK@\ *%+*) echo "Raise volume" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SINK@\ *%-*) echo "Lower volume" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SOURCE@\ 1%+*) echo "Raise microphone volume slightly" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SOURCE@\ 1%-*) echo "Lower microphone volume slightly" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SOURCE@\ *%+*) echo "Raise microphone volume" ;;
    wpctl\ set-volume\ @DEFAULT_AUDIO_SOURCE@\ *%-*) echo "Lower microphone volume" ;;
    brightnessctl\ set\ 100%*) echo "Set brightness to maximum" ;;
    "brightnessctl set 1%") echo "Set brightness to minimum" ;;
    brightnessctl\ set\ 1%+*) echo "Increase brightness slightly" ;;
    brightnessctl\ set\ 1%-*) echo "Decrease brightness slightly" ;;
    brightnessctl\ set\ *%+*) echo "Increase brightness" ;;
    brightnessctl\ set\ *%-*) echo "Decrease brightness" ;;
    "playerctl play-pause") echo "Play/pause media" ;;
    "playerctl next") echo "Next media track" ;;
    "playerctl previous") echo "Previous media track" ;;
    flameshot\ full*) echo "Fullscreen screenshot" ;;
    flameshot*) echo "Screenshot" ;;
    *) echo "$cmd" ;;
  esac
}

sway_dynamic_bindings() {
  local file line flags combo command description
  local is_code=0
  local emitted=0
  local mods key

  discover_sway_bind_files || return 1
  load_sway_variables

  for file in "${SWAY_BIND_FILES[@]}"; do
    while IFS= read -r line; do
      line=$(trim "$line")
      [[ -z $line || $line == "#"* ]] && continue
      [[ $line != "bindsym "* && $line != "bindcode "* ]] && continue

      is_code=0
      if [[ $line == "bindcode "* ]]; then
        is_code=1
      fi
      line="${line#bindsym }"
      line="${line#bindcode }"

      while [[ $line == "--"* ]]; do
        flags="${line%% *}"
        line="${line#"$flags"}"
        line=$(trim "$line")
      done

      combo="${line%% *}"
      command="${line#"$combo"}"
      command=$(trim "$command")

      if [[ $command == *" #"* ]]; then
        command="${command%%" #"*}"
        command=$(trim "$command")
      fi

      IFS=$'\x1f' read -r mods key <<<"$(sway_resolve_combo "$combo")"
      [[ -z $key ]] && continue

      ((is_code)) && key="code:$key"
      [[ $key == [a-z] ]] && key="${key^^}"

      description=$(sway_binding_description "$command")
      description="${description//,/;}"
      [[ -z $description ]] && continue

      printf '%s,%s,%s,sway,%s\n' "$mods" "$key" "$description" "$command"
      ((emitted += 1))
    done <"$file"
  done

  ((emitted > 0))
}

# Parse and format keybindings
#
# `awk` does the heavy lifting:
# - Set the field separator to a comma ','.
# - Joins the key combination (e.g., "SUPER + Q").
# - Joins the command that the key executes.
# - Prints display text and dispatch metadata as tab-separated fields.
parse_binding_records() {
  awk -F, '
{
    # Combine the modifier and key (first two fields)
    key_combo = $1 " + " $2;

    # Clean up: strip leading "+" if present, trim spaces
    gsub(/^[ \t]*\+?[ \t]*/, "", key_combo);
    gsub(/[ \t]+$/, "", key_combo);

    # Use description, if set
    action = $3;
    dispatcher = $4;

    # Reconstruct the dispatcher arg from the remaining fields
    arg = "";
    for (i = 5; i <= NF; i++) {
        arg = arg $i (i < NF ? "," : "");
    }

    if (action == "") {
        # Reconstruct the command from the remaining fields
        for (i = 4; i <= NF; i++) {
            action = action $i (i < NF ? "," : "");
        }

        # Clean up trailing commas, remove leading "exec, ", and trim
        sub(/,$/, "", action);
        gsub(/(^|,)[[:space:]]*exec[[:space:]]*,?/, "", action);
        gsub(/(^|[[:space:]])uwsm(-app| app)[[:space:]]+--[[:space:]]+/, "", action);
        gsub(/^[ \t]+|[ \t]+$/, "", action);
        gsub(/[ \t]+/, " ", key_combo);  # Collapse multiple spaces to one
    }

    if (action != "") {
        printf "%-35s → %s\t%s\t%s\n", key_combo, action, dispatcher, arg;
    }
}'
}

prioritize_entries() {
  awk -F '\t' '
  {
    line = $1
    prio = 50
    if (match(line, /Keybindings/)) prio = 0
    if (match(line, /Magikos menu/))  prio = 1
    if (match(line, /Terminal/)) prio = 2
    if (match(line, /Browser/) && !match(line, /Browser[[:space:]]*\(/) && !match(line, /SUPER SHIFT.*\+.*B.*→.*Browser/)) prio = 3
    if (match(line, /File manager/) && !match(line, /File manager \(cwd\)/))  prio = 4
    if (match(line, /Launch apps/))  prio = 5
    if (match(line, /System menu/))  prio = 6
    if (match(line, /Theme menu/))  prio = 7
    if (match(line, /Full screen/))  prio = 8
    if (match(line, /Full width/))  prio = 9
    if (match(line, /Close window/))  prio = 10
    if (match(line, /Close all windows/))  prio = 11
    if (match(line, /Lock system/))  prio = 12
    if (match(line, /Toggle window floating/))  prio = 13
    if (match(line, /Toggle window split/))  prio = 14
    if (match(line, /Pop window/))  prio = 15
    if (match(line, /Universal/))  prio = 16
    if (match(line, /Clipboard/))  prio = 17
    if (match(line, /Audio controls/))  prio = 18
    if (match(line, /Bluetooth controls/))  prio = 19
    if (match(line, /Wifi controls/))  prio = 20
    if (match(line, /Emojis/))  prio = 21
    if (match(line, /Color picker/))  prio = 22
    if (match(line, /Screenshot/))  prio = 23
    if (match(line, /Screenrecording/))  prio = 24
    if (match(line, /Tmux/)) prio = 25
    if (match(line, /Herdr/)) prio = 26
    if (match(line, /SUPER SHIFT.*\+.*B.*→.*Browser/)) prio = 27
    if (match(line, /File manager \(cwd\)/))  prio = 28
    if (match(line, /(Switch|Next|Former|Previous).*workspace/))  prio = 29
    if (match(line, /Move window to workspace/))  prio = 30
    if (match(line, /Move window silently to workspace/))  prio = 31
    if (match(line, /Swap window/))  prio = 32
    if (match(line, /Focus/))  prio = 33
    if (match(line, /Move window$/))  prio = 34
    if (match(line, /Resize window/))  prio = 35
    if (match(line, /Expand window/))  prio = 36
    if (match(line, /Shrink window/))  prio = 37
    if (match(line, /scratchpad/))  prio = 38
    if (match(line, /notification/))  prio = 39
    if (match(line, /Toggle window transparency/))  prio = 40
    if (match(line, /Toggle workspace gaps/))  prio = 41
    if (match(line, /Toggle nightlight/))  prio = 42
    if (match(line, /Toggle locking/))  prio = 43
    if (match(line, /group/))  prio = 94
    if (match(line, /Scroll active workspace/))  prio = 95
    if (match(line, /Cycle to/))  prio = 96
    if (match(line, /Reveal active/))  prio = 97
    if (match(line, /Apple Display/))  prio = 98
    if (match(line, /XF86/))  prio = 99
    if (match(line, /Tmux keybindings/)) prio = 100
    if (match(line, /Herdr keybindings/)) prio = 101

    # print "priority<TAB>record"
    printf "%d\t%s\n", prio, $0
  }' |
  sort -k1,1n -k2,2 |
  cut -f2-
}

output_binding_records_uncached() {
  local sources

  sources=$(sway_dynamic_bindings) || return 1

  printf '%s\n' "$sources" |
    sort -u |
    parse_keycodes |
    parse_binding_records |
    prioritize_entries
}

keybindings_cache_key() {
  {
    printf 'v12\n'
    printf 'sway\n'
    if discover_sway_bind_files; then
      cat "${SWAY_BIND_FILES[@]}" 2>/dev/null
    fi
  } | sha256sum | awk '{ print $1 }'
}

refresh_keybindings_cache() {
  local cache_dir="$1"
  local cache_file="$2"
  local cache_name="$3"
  local tmp_file

  tmp_file=$(mktemp "$cache_dir/keybindings.XXXXXX") || return 1

  if output_binding_records_uncached >"$tmp_file"; then
    mv "$tmp_file" "$cache_file"
    find "$cache_dir" -maxdepth 1 -type f -name 'keybindings-*.records' ! -name "$cache_name" -delete 2>/dev/null || true
  else
    rm -f "$tmp_file"
    return 1
  fi
}

output_binding_records() {
  local cache_dir cache_file cache_name

  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/magikos"
  cache_name="keybindings-$(keybindings_cache_key).records"
  cache_file="$cache_dir/$cache_name"

  if [[ -s $cache_file ]]; then
    cat "$cache_file"
  elif mkdir -p "$cache_dir" 2>/dev/null && refresh_keybindings_cache "$cache_dir" "$cache_file" "$cache_name"; then
    cat "$cache_file"
  else
    output_binding_records_uncached
  fi
}

output_keybindings() {
  output_binding_records | cut -f1
}

trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf '%s\n' "$value"
}

dispatch_binding() {
  local dispatcher="$1"
  local arg="$2"

  case "$dispatcher" in
    sway)
      [[ -n $arg ]] && swaymsg -- "$arg" >/dev/null 2>&1
      ;;
    "") return 1 ;;
  esac
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  records=$(output_binding_records)
  selection=$(cut -f1 <<<"$records" |
    magikos-menu-select 'Keybindings' -- --width 800 --height 500)

  if [[ -n $selection ]]; then
    record=$(awk -F '\t' -v selection="$selection" '$1 == selection { print; exit }' <<<"$records")
    dispatcher=$(cut -f2 <<<"$record")
    arg=$(cut -f3- <<<"$record")

    dispatch_binding "$dispatcher" "$arg"
  fi
fi
