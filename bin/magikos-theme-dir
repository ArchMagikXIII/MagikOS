#!/bin/bash

# magikos:summary=Print the directory holding a theme, preferring a user-installed copy
# magikos:args=<theme-name>
# magikos:examples=magikos theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: magikos-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/magikos/themes/$theme ]]; then
  echo "$HOME/.config/magikos/themes/$theme"
else
  echo "$MAGIKOS_PATH/themes/$theme"
fi
