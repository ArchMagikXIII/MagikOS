#!/bin/bash

# magikos:summary=Launch Signal or start its installer when missing.

set -e

WINDOW_ID=$(swaymsg -t get_tree 2>/dev/null | jq -r '
  .. | objects
  | select(
      (.app_id? // "" | test("\\bsignal\\b";"i")) or
      (.window_properties.class? // "" | test("\\bsignal\\b";"i")) or
      (.name? // "" | test("\\bsignal\\b";"i"))
    )
  | .id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  swaymsg "[con_id=$WINDOW_ID] focus" >/dev/null 2>&1
elif [[ -x /usr/bin/signal-desktop ]]; then
  exec setsid uwsm-app -- /usr/bin/signal-desktop
else
  exec magikos-launch-floating-terminal-with-presentation magikos-install-service-signal
fi
