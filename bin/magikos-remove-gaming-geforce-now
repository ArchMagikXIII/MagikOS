#!/bin/bash

# magikos:summary=Remove the GeForce NOW Flatpak app and its data.
# magikos:group=remove
# magikos:name=gaming geforce-now

set -e

if magikos-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
