#!/bin/bash

# magikos:summary=Set and launch the default coding agent
# magikos:args=[opencode|agy]
# magikos:examples=magikos default agent | magikos default agent opencode | magikos default agent agy

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

agent_file="$HOME/.config/magikos/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: Magikos picks no agent for you, so
  # the menu leaves every entry unchecked until one is chosen.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
opencode | open-code) agent="opencode"; name="OpenCode" ;;
agy | antigravity | antigravity-cli | gemini | gemini-cli) agent="agy"; name="Antigravity"; agent_package="antigravity-cli" ;;
*)
  echo "Usage: magikos-default-agent <opencode|agy>"
  exit 1
  ;;
esac

agent_package=${agent_package:-$agent}

if [[ $installing == "false" ]] && ! mise where "$agent_package" &>/dev/null; then
  exec magikos-launch-floating-terminal-with-presentation magikos-default-agent --install "$agent"
fi

if ! mise use -g "$agent_package"; then
  if [[ $installing == "true" ]]; then
    echo "Could not install $name with mise" >&2
  else
    echo "Could not set $name as the default coding agent" >&2
  fi
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$agent" >"$agent_file"

if [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec magikos-agent --inline
else
  exec magikos-agent
fi
