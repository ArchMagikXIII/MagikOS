#!/bin/bash

# magikos:summary=Package backend detection shared by the magikos pkg commands. Source it; do not execute.

# Detects whether this system manages packages with pacman (Arch, CachyOS) or
# dnf (Fedora), then exposes one vocabulary for both. MAGIKOS_PKG_BACKEND
# overrides detection for tests and unusual setups.

if [[ -z ${MAGIKOS_PKG_BACKEND:-} ]]; then
  if command -v pacman >/dev/null 2>&1; then
    MAGIKOS_PKG_BACKEND=pacman
  elif command -v dnf >/dev/null 2>&1; then
    MAGIKOS_PKG_BACKEND=dnf
  else
    echo "Error: no supported package manager found (expected pacman or dnf)" >&2
    return 1 2>/dev/null || exit 1
  fi
fi

backend_is_pacman() {
  [[ $MAGIKOS_PKG_BACKEND == pacman ]]
}

# True when every named package is installed.
pkg_installed() {
  local pkg
  for pkg in "$@"; do
    case $MAGIKOS_PKG_BACKEND in
      pacman) pacman -Q "$pkg" &>/dev/null || return 1 ;;
      dnf) rpm -q "$pkg" &>/dev/null || return 1 ;;
    esac
  done
}

# Every package available to install, one name per line.
pkg_list_available() {
  case $MAGIKOS_PKG_BACKEND in
    pacman) pacman -Slq ;;
    dnf) dnf repoquery --qf '%{name}' ;;
  esac
}

# Every installed package, one name per line.
pkg_list_installed() {
  case $MAGIKOS_PKG_BACKEND in
    pacman) pacman -Qq ;;
    dnf) rpm -qa --qf '%{NAME}\n' ;;
  esac
}

# Explicitly installed packages (not pulled in as dependencies).
pkg_list_explicit() {
  case $MAGIKOS_PKG_BACKEND in
    pacman) pacman -Qqe ;;
    dnf) dnf repoquery --userinstalled --qf '%{name}' ;;
  esac
}

# Details for a package that is available but not necessarily installed.
pkg_info_new() {
  case $MAGIKOS_PKG_BACKEND in
    pacman) pacman -Sii "$1" ;;
    dnf) dnf info "$1" ;;
  esac
}

# Details for an installed package.
pkg_info_installed() {
  case $MAGIKOS_PKG_BACKEND in
    pacman) pacman -Qi "$1" ;;
    dnf) dnf info "$1" ;;
  esac
}

# Privileged transactions stay as command arrays so callers keep control of
# sudo and root handling exactly as they did against raw pacman.
case $MAGIKOS_PKG_BACKEND in
  pacman)
    PKG_INSTALL_CMD=(pacman -S --noconfirm --needed)
    PKG_REMOVE_CMD=(pacman -Rns --noconfirm)
    PKG_UPGRADE_CMD=(env MAGIKOS_UPDATE_PACMAN=1 pacman -Syu --noconfirm)
    PKG_SYNC_CMD=(env MAGIKOS_UPDATE_PACMAN=1 pacman -Syyuu --noconfirm)
    ;;
  dnf)
    PKG_INSTALL_CMD=(dnf install -y)
    PKG_REMOVE_CMD=(dnf remove -y)
    PKG_UPGRADE_CMD=(env LC_ALL=C dnf upgrade -y)
    PKG_SYNC_CMD=(env LC_ALL=C dnf distro-sync -y)
    ;;
esac
