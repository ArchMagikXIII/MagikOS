#!/bin/bash

# magikos:summary=Launch or focus on a given web app identified by the window-pattern.
# magikos:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: magikos-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="magikos-launch-webapp $@"

exec magikos-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
