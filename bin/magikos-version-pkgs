#!/bin/bash
# magikos-version-pkgs — last system package upgrade time
# magikos:summary=Show when system packages last upgraded, for fastfetch
source magikos-pkg-backend

log="/var/log/pacman.log"
if [[ -f "$log" ]]; then
  last=$(grep "upgraded" "$log" | tail -1 | sed -E 's/\[([^]]+)\].*/\1/')
  [[ -n "$last" ]] && date -d "$last" "+%A, %B %d %Y at %H:%M" && exit 0
fi
echo "unknown"
