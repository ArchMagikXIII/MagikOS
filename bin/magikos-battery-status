#!/bin/bash

# magikos:summary=Returns a formatted battery status string with percentage and power draw/charge.
# magikos:args=[--shell]

shell_output=false
power_supply_path="${MAGIKOS_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: magikos-battery-status [--shell]" >&2
    exit 2
    ;;
esac

battery=$(upower -e 2>/dev/null | grep BAT | head -n 1)
[[ -z $battery ]] && exit 0

battery_info=$(upower -i "$battery")

percentage=$(awk '/percentage/ { print int($2); exit }' <<<"$battery_info")
capacity=$(awk '/energy-full:/ { printf "%d", $2; exit }' <<<"$battery_info")
time_remaining=$(awk '/time to (empty|full)/ {
  # UPower formats: "3h 30min", "45min", "2h 0min", "18.6 minutes", "2.5 hours"
  total = 0
  for (i = 4; i <= NF; i++) {
    if ($i ~ /^[0-9]+h$/) { total += int($i) * 60 }
    else if ($i ~ /^[0-9.]+min$/) { total += int($i) }
    else if ($i ~ /^[0-9.]+$/) {
      val = $i + 0
      if ((i+1) <= NF && $(i+1) ~ /^h/) { total += val * 60 }
      else if ((i+1) <= NF && $(i+1) ~ /^(min|minutes)$/) { total += int(val) }
    }
  }
  hours = int(total / 60)
  minutes = int(total) % 60
  if (hours > 0 && minutes > 0) printf "%dh %dm", hours, minutes
  else if (hours > 0) printf "%dh", hours
  else printf "%dm", minutes
  exit
}' <<<"$battery_info")
power_rate_raw=$(awk '/energy-rate/ { print $2; exit }' <<<"$battery_info")
energy_upower=$(awk '/^energy:/ { print $2; exit }' <<<"$battery_info")
native_path=$(awk '/native-path/ { print $2; exit }' <<<"$battery_info")
battery_path="$power_supply_path/$native_path"

# UPower's energy-rate can lag the kernel telemetry by tens of seconds. Use
# the instantaneous sysfs reading when available so the open panel stays live.
if [[ -r $battery_path/power_now ]]; then
  raw_power=$(cat "$battery_path/power_now" 2>/dev/null)
  if [[ $raw_power =~ ^[0-9]+$ ]]; then
    power_rate_raw=$(awk -v microwatts="$raw_power" 'BEGIN { print microwatts / 1000000 }')
  fi
elif [[ -r $battery_path/current_now && -r $battery_path/voltage_now ]]; then
  raw_current=$(cat "$battery_path/current_now" 2>/dev/null)
  raw_voltage=$(cat "$battery_path/voltage_now" 2>/dev/null)
  if [[ $raw_current =~ ^[0-9]+$ && $raw_voltage =~ ^[0-9]+$ ]]; then
    power_rate_raw=$(awk \
      -v microamps="$raw_current" \
      -v microvolts="$raw_voltage" \
      'BEGIN { print microamps * microvolts / 1000000000000 }')
  fi
fi

power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')
state=$(awk '/state/ { print $2; exit }' <<<"$battery_info")

# Fallback: compute time remaining when UPower omits it (e.g. energy-rate is
# 0 right after resume).  Use sysfs energy_now when available, otherwise
# UPower's energy field.
if [[ -z $time_remaining ]]; then
  energy_wh=0
  if [[ -r $battery_path/energy_now ]]; then
    energy_wh=$(awk '{ printf "%.2f", $1 / 1000000 }' "$battery_path/energy_now" 2>/dev/null)
  elif [[ -n $energy_upower ]]; then
    energy_wh=$energy_upower
  fi

  energy_full_wh=0
  if [[ -r $battery_path/energy_full ]]; then
    energy_full_wh=$(awk '{ printf "%.2f", $1 / 1000000 }' "$battery_path/energy_full" 2>/dev/null)
  elif [[ -n $capacity ]]; then
    energy_full_wh=$capacity
  fi

  rate_float="${power_rate_raw:-0}"

  # When no power rate is available, estimate from energy_now deltas stored in
  # a temp file between consecutive 5-second refresh cycles.
  if awk -v r="$rate_float" 'BEGIN { exit !(r <= 0.05) }' && [[ -r $battery_path/energy_now ]]; then
    sample_dir="${XDG_RUNTIME_DIR:-/tmp}/magikos-battery"
    sample_file="$sample_dir/energy"
    mkdir -p "$sample_dir" 2>/dev/null

    now_raw=$(cat "$battery_path/energy_now" 2>/dev/null)
    if [[ $now_raw =~ ^[0-9]+$ ]]; then
      now_wh=$(awk -v uj="$now_raw" 'BEGIN { printf "%.2f", uj / 1000000 }')

      if [[ -r $sample_file ]]; then
        prev_wh=$(cat "$sample_file" 2>/dev/null)
        if [[ -n $prev_wh ]] && awk -v p="$prev_wh" -v n="$now_wh" -v s="$state" 'BEGIN {
          diff = p - n
          if (s == "charging") diff = -diff
          exit !(diff > 0.01)
        }'; then
          rate_float=$(awk -v prev="$prev_wh" -v now="$now_wh" -v state="$state" 'BEGIN {
            diff_wh = prev - now
            if (state == "charging") diff_wh = -diff_wh
            if (diff_wh < 0) diff_wh = -diff_wh
            # Panel refreshes every ~5 seconds; rate = energy / hours
            printf "%.2f", diff_wh / (5.0 / 3600.0)
          }')
        fi
      fi

      printf '%s' "$now_raw" > "$sample_file"
    fi
  fi

  if awk -v r="$rate_float" 'BEGIN { exit !(r > 0.05) }' && awk -v e="$energy_wh" 'BEGIN { exit !(e > 0) }'; then
    time_remaining=$(awk -v energy="$energy_wh" -v full="$energy_full_wh" -v rate="$rate_float" -v state="$state" 'BEGIN {
      if (state == "charging") {
        remaining = full - energy
        if (remaining < 0) remaining = energy
      } else {
        remaining = energy
      }
      minutes = int(remaining / rate * 60)
      if (minutes < 1) minutes = 1
      h = int(minutes / 60)
      m = minutes % 60
      if (h > 0 && m > 0) printf "%dh %dm", h, m
      else if (h > 0) printf "%dh", h
      else printf "%dm", m
    }')
  fi
fi
threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")

[[ -z $threshold_end ]] && threshold_end=$(cat "$power_supply_path"/BAT*/charge_control_end_threshold 2>/dev/null | head -1)
[[ -z $threshold_start ]] && threshold_start=$(cat "$power_supply_path"/BAT*/charge_control_start_threshold 2>/dev/null | head -1)

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_idle=false
if awk -v rate="${power_rate_raw:-0}" 'BEGIN { exit !(rate <= 0.2) }'; then
  charge_idle=true
fi

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=$(cat "$power_supply_path"/BAT*/cycle_count 2>/dev/null | head -1)

  [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  exit 0
fi

if [[ $charge_holding == "true" ]]; then
  if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
    threshold_label="${threshold_start}-${threshold_end}%"
  else
    threshold_label="${threshold_end}%"
  fi

  echo "Battery ${percentage}%  ·  Holding at ${threshold_label}  ·  ${power_rate}W / ${capacity}Wh"
elif [[ $state == "charging" ]]; then
  echo "Battery ${percentage}%  ·  ${time_remaining} to full  ·   ${power_rate}W / ${capacity}Wh"
else
  echo "Battery ${percentage}%  ·  ${time_remaining} left  ·   ${power_rate}W / ${capacity}Wh"
fi
