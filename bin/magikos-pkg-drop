#!/bin/bash

# magikos:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# magikos:args=<packages...>
# magikos:requires-sudo=true

source magikos-pkg-backend

installed=()
declare -A installed_exact=()
declare -A selected=()

while IFS= read -r package_name; do
  installed_exact[$package_name]=1
done < <(pkg_list_installed)

for pkg in "$@"; do
  if [[ -n ${installed_exact[$pkg]} && -z ${selected[$pkg]} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  sudo "${PKG_REMOVE_CMD[@]}" "${installed[@]}"

  # pacman -Rns sweeps orphaned dependencies in the same transaction, so its
  # backend leaves this array empty. Backends whose remove verb cannot also
  # collect orphans (apt) fill it, and the sweep runs only once the removal
  # itself succeeded.
  if (( ${#PKG_AUTOREMOVE_CMD[@]} > 0 )); then
    sudo "${PKG_AUTOREMOVE_CMD[@]}"
  fi
fi
