#!/bin/bash

# magikos:summary=Enable, disable, or toggle an input device
# magikos:args=<touchpad|touchscreen> [on|off|toggle]
# magikos:hidden=true

KIND="${1:-}"
ACTION="${2:-toggle}"

case "$KIND" in
  touchpad) LABEL="Touchpad" ICON="touchpad" ;;
  touchscreen) LABEL="Touchscreen" ICON="touch" ;;
  *)
    echo "Usage: magikos-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
    exit 1
    ;;
esac

# Flag file records the disabled state so it survives restarts
STATE_FILE="$HOME/.local/state/magikos/toggles/$KIND-disabled"

device="$("magikos-hw-$KIND")"

if [[ -z $device ]]; then
  echo "No $KIND device found" >&2
  exit 1
fi

enable() {
  swaymsg input "$device" events enabled >/dev/null
  rm -f "$STATE_FILE"
  magikos-osd -i "$ICON" -m "$LABEL enabled"
}

disable() {
  swaymsg input "$device" events disabled >/dev/null
  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$device" >"$STATE_FILE"
  magikos-osd -i "$ICON" -m "$LABEL disabled"
}

case "$ACTION" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_FILE ]]; then enable; else disable; fi ;;
  *)
    echo "Usage: magikos-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
    exit 1
    ;;
esac
