#!/bin/bash

# magikos:summary=Send the low battery warning notification and run battery-low hooks.
# magikos:args=<percentage>
# magikos:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: magikos-battery-low <percentage>" >&2
  exit 1
fi

level=$1

magikos-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
magikos-hook battery-low "$level"
