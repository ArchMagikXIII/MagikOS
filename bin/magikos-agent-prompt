#!/bin/bash

# magikos:summary=Launch the default coding agent with a prompt
# magikos:args=[--inline] <prompt...>
# magikos:examples=magikos agent prompt "Review this project"

# Prompts live here rather than on `magikos agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: magikos agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec magikos-agent "${inline[@]}" --prompt "$*"
