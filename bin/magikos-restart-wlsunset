#!/bin/bash

# magikos:summary=Restart the night light service (blue light filtering).

# Preserve the pinned temperature when bouncing the daemon; fall back to
# night warmth when nothing is running.
temp=$(pgrep -ax wlsunset 2>/dev/null | head -n1 | awk '{for(i=2;i<NF;i++) if($i=="-t"){print $(i+1); exit}}')
temp=${temp:-4000}
magikos-restart-app wlsunset -t "$temp" -T "$temp"
