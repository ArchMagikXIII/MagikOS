# Arch mirrors for the MagikOS live environment. This file is seeded directly
# into the airootfs, so it also wins over pacstrap copying the build host's
# mirrorlist at build time.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.0xem.ma/arch/$repo/os/$arch