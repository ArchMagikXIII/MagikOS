# Placeholder upstream mirror until stable-mirror.magikos.org is live. The commented line keeps
# magikos-version-channel reporting this channel correctly.
#Server = https://stable-mirror.magikos.org/$repo/os/$arch
#
# Upstream Arch is listed ahead of archlinux.cachyos.org because the CachyOS mirror has been
# observed syncing a repo database before the matching package files land, which makes every
# full upgrade abort on a 404 (glibc 2.44+r50 on 2026-10-02). Upstream is the canonical sync
# source; CachyOS stays last as a fallback.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.leaseweb.com/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://archlinux.cachyos.org/repo/$repo/os/$arch
