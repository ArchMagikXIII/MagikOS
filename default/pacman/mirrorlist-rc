# Placeholder upstream mirror until rc-mirror.magikos.org is live. The commented line keeps
# magikos-version-channel reporting this channel correctly.
#Server = https://rc-mirror.magikos.org/$repo/os/$arch
#
# Upstream Arch leads because archlinux.cachyos.org has been observed syncing a repo database
# before the matching package files, making full upgrades abort on a 404. CachyOS stays as a
# fallback.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.leaseweb.com/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://archlinux.cachyos.org/repo/$repo/os/$arch
