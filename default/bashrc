# Magikos environment (MAGIKOS_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/magikos/default/bash/env-bootstrap ]] && source /usr/share/magikos/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Magikos aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$MAGIKOS_PATH/default/bash/rc"

# Starship drives the bash prompt (config: ~/.config/starship.toml)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Greet interactive shells with the system summary and ASCII art
if [[ -r $HOME/.config/fastfetch/MagikOS.txt ]] && command -v fastfetch >/dev/null 2>&1; then
  fastfetch
fi

