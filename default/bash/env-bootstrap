# Single source of truth for MAGIKOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/magikos.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-magikos          (Hyprland session via uwsm)
#   /usr/share/magikos/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/magikos.conf is written by magikos-dev-link and reset by
# magikos-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/magikos.conf ]; then
  . /etc/magikos.conf
  : "${MAGIKOS_PATH:=/usr/share/magikos}"
else
  MAGIKOS_PATH=/usr/share/magikos
fi
export MAGIKOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/magikos-* via the magikos package — prepending
# /usr/share/magikos/bin would just be noise.
if [ "$MAGIKOS_PATH" != /usr/share/magikos ]; then
  case ":$PATH:" in
    *":${MAGIKOS_PATH%/}/bin:"*) ;;
    *) PATH="${MAGIKOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
