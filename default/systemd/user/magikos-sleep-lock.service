[Unit]
Description=Lock Magikos before suspend
# The monitor calls into the running Magikos shell. Wait until UWSM has imported
# MAGIKOS_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=MAGIKOS_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/magikos-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
